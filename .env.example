# ==============================================================================
# NGHIEM LINH LANGUAGE WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment pipeline.
# NEVER commit the actual .env file or real secrets to version control.

# Application Server
PORT=4000
NODE_ENV=production

# Supabase BaaS (PostgreSQL) Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend or public client code!
